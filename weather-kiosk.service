# Launches the labwc Wayland compositor on tty1, which in turn autostarts
# Chromium in kiosk mode via ~matt/.config/labwc/autostart, pointed at the
# weather-web.service dashboard at http://localhost:5000/display.
[Unit]
Description=Weather Kiosk Display (labwc + Chromium)
After=weather-web.service seatd.service
Wants=weather-web.service seatd.service

[Service]
User=matt
Group=matt
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=WAYLAND_DISPLAY=wayland-1
ExecStart=/usr/bin/labwc
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
